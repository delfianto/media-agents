# Copy to .env (next to this file, or point --env-file at it) and fill in
# real values. Every key is prefixed MEDIAORGANIZER_ -- the real process
# environment always overrides whatever's in this file, so an automated
# harness can inject/override values without editing it on disk.

# Required. Free key: themoviedb.org account -> Settings -> API.
MEDIAORGANIZER_TMDB_API_KEY=

# Required. Where unorganized downloads land, and where organized files go.
MEDIAORGANIZER_INBOX_DIR=/path/to/downloads
MEDIAORGANIZER_MOVIES_DIR=/path/to/library/Movies
MEDIAORGANIZER_TV_SHOWS_DIR=/path/to/library/TV Shows

# "plex" or "jellyfin" -- controls provider-ID tag style ({tmdb-123} vs
# [tmdbid-123]) and episode filename format. Default: plex.
MEDIAORGANIZER_SERVER=plex

# Optional. Without an OpenSubtitles API key, no subtitles are fetched (NFO/
# artwork/renaming still happen). Register an "API Consumer" in an
# opensubtitles.com account's profile to get one.
MEDIAORGANIZER_OPENSUBTITLES_API_KEY=
# Optional login -- raises the daily download quota above the anonymous
# 5/day/IP ceiling. Leave blank to stay anonymous.
MEDIAORGANIZER_OPENSUBTITLES_USERNAME=
MEDIAORGANIZER_OPENSUBTITLES_PASSWORD=

# Comma-separated ISO 639-1 codes. Default: en
MEDIAORGANIZER_SUBTITLE_LANGUAGES=en

# Minimum title-match confidence (0.0-1.0) to auto-apply a match rather than
# flag it for manual review. Default: 0.75
MEDIAORGANIZER_MIN_CONFIDENCE=0.75

# Sent as the User-Agent header to both TMDB and OpenSubtitles. Default:
# media-organizer/0.1
MEDIAORGANIZER_USER_AGENT=media-organizer/0.1
