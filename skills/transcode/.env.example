# Copy to .env in the invocation directory (or point --env-file at it) and fill in
# real values as needed. Every key is optional -- this skill works with zero
# config file at all -- and every key is prefixed TRANSCODE_. The real
# process environment always overrides whatever's in this file, and an
# explicit CLI flag overrides both.

# Where to write converted files, mirroring each source file's path relative
# to --root, instead of swapping in place. When set, the original source is
# never touched (no backup/delete). Default: unset (in-place mode).
TRANSCODE_OUTPUT_DIR=

# Which audio/subtitle language to keep by default (ISO 639-2, e.g. "eng"),
# or "all" to keep every track. Falls back to keeping every audio track if
# nothing matches (never produces a silent file); subtitles have no such
# fallback since zero subtitles is a normal outcome. Default: eng
TRANSCODE_AUDIO_LANG=eng
TRANSCODE_SUBTITLE_LANG=eng

# Cap output video bitrate to this fraction of the source's own video
# bitrate -- the safety net against producing a file larger than an
# already-efficiently-encoded source. Default: 0.85
TRANSCODE_MAX_BITRATE_FRACTION=0.85

# Note: TRANSCODE_ROOT (media library root override) is a plain
# environment variable resolved before this .env file is even read (it sets
# --root's own default) -- set it in the real environment, not here.
